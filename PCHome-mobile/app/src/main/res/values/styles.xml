<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PCHome" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/PCHome_cyan</item>
        <item name="colorPrimaryVariant">@color/PCHome_cyan</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/PCHome_blue</item>
        <item name="colorSecondaryVariant">@color/PCHome_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/PCHome_background</item>
        <item name="colorSurface">@color/PCHome_surface</item>
        <item name="colorSurfaceVariant">@color/PCHome_panel</item>
        <item name="colorOnSurface">@color/PCHome_text</item>
        <item name="colorOnSurfaceVariant">@color/PCHome_muted</item>
        <item name="colorError">@color/PCHome_danger</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Theme.PCHome.Fullscreen" parent="Theme.PCHome">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="PinText">
        <item name="android:textColor">@color/PCHome_cyan</item>
        <item name="android:textSize">48sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="StatusText">
        <item name="android:textColor">@color/PCHome_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PCHomeButton">
        <item name="android:backgroundTint">@color/PCHome_cyan</item>
        <item name="android:textColor">@color/black</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Neon ana düğme: tam genişlik, kalın, cyan zemin -->
    <style name="Widget.PCHome.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/PCHome_cyan</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Kumanda düğmesi: ince dış çizgili, küçük, neon yazı -->
    <style name="Widget.PCHome.ControlButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/PCHome_border</item>
        <item name="android:textColor">@color/PCHome_cyan</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- Bağlantı kartı: koyu zemin, ince neon çerçeve -->
    <style name="Widget.PCHome.ConnectCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/PCHome_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeColor">@color/PCHome_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
