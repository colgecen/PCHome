<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== Tema: nötr kömür + tek indigo vurgu ===================== -->
    <style name="Theme.PCHome" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/PCHome_cyan</item>
        <item name="colorOnPrimary">@color/PCHome_ink</item>
        <item name="colorPrimaryContainer">@color/PCHome_surface_high</item>
        <item name="colorOnPrimaryContainer">@color/PCHome_text</item>
        <item name="colorSecondary">@color/PCHome_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/PCHome_indigo</item>
        <item name="android:colorBackground">@color/PCHome_background</item>
        <item name="colorSurface">@color/PCHome_surface</item>
        <item name="colorSurfaceVariant">@color/PCHome_panel</item>
        <item name="colorOnSurface">@color/PCHome_text</item>
        <item name="colorOnSurfaceVariant">@color/PCHome_muted</item>
        <item name="colorOutline">@color/PCHome_border</item>
        <item name="colorError">@color/PCHome_danger</item>
        <item name="colorOnError">@color/PCHome_ink</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="materialButtonStyle">@style/Widget.PCHome.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.PCHome.Input</item>
    </style>

    <style name="Theme.PCHome.Fullscreen" parent="Theme.PCHome">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/PCHome_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- ===================== Tipografi ===================== -->
    <style name="TextAppearance.PCHome.Hero" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/PCHome_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">0.98</item>
    </style>

    <style name="TextAppearance.PCHome.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/PCHome_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PCHome.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/PCHome_muted</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.PCHome.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/PCHome_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.PCHome.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/PCHome_muted</item>
    </style>

    <!-- ===================== Düğmeler ===================== -->
    <style name="Widget.PCHome.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/PCHome_silver</item>
        <item name="android:textColor">@color/PCHome_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconTint">@color/PCHome_ink</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">10dp</item>
        <item name="iconSize">20dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PCHome.Button.Soft" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/PCHome_surface_high</item>
        <item name="android:textColor">@color/PCHome_text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">@color/PCHome_muted</item>
        <item name="iconSize">17dp</item>
        <item name="iconPadding">6dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PCHome.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">#FF2A1518</item>
        <item name="android:textColor">@color/PCHome_danger</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">@color/PCHome_danger</item>
        <item name="iconSize">17dp</item>
        <item name="iconPadding">6dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PCHome.Button.Key" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/PCHome_surface</item>
        <item name="android:textColor">@color/PCHome_muted</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">11sp</item>
        <item name="cornerRadius">9dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="iconTint">@color/PCHome_muted</item>
        <item name="iconSize">14dp</item>
        <item name="iconPadding">3dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.PCHome.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/PCHome_cyan</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="iconTint">@color/PCHome_cyan</item>
        <item name="iconSize">16dp</item>
    </style>

    <!-- ===================== Girdiler ===================== -->
    <style name="Widget.PCHome.Input" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/PCHome_surface_high</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxStrokeColor">@color/PCHome_cyan</item>
        <item name="hintTextColor">@color/PCHome_muted</item>
        <item name="android:textColorHint">@color/PCHome_muted</item>
        <item name="startIconTint">@color/PCHome_muted</item>
        <item name="endIconTint">@color/PCHome_muted</item>
        <item name="helperTextTextColor">@color/PCHome_dim</item>
        <item name="errorTextColor">@color/PCHome_danger</item>
        <item name="boxCollapsedPaddingTop">0dp</item>
        <item name="boxBackgroundMode">filled</item>
    </style>

    <!-- ===================== Kartlar / çipler ===================== -->
    <style name="Widget.PCHome.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/PCHome_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.PCHome.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/PCHome_surface_high</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="android:textColor">@color/PCHome_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:clickable">false</item>
        <item name="android:checkable">false</item>
    </style>

</resources>
