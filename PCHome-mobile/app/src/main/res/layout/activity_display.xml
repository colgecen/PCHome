<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.PCHome.mobile.ui.ReticleView
        android:id="@+id/reticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.chip.Chip
        android:id="@+id/stream_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="top|start"
        android:text="@string/waiting_for_stream"
        android:checkable="false"
        android:textSize="12sp"
        app:chipBackgroundColor="@color/PCHome_panel"
        app:chipStrokeWidth="1dp"
        app:chipStrokeColor="@color/PCHome_cyan"
        android:textColor="@color/PCHome_text" />

    <com.google.android.material.chip.Chip
        android:id="@+id/info_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="top|end"
        android:checkable="false"
        android:textSize="12sp"
        app:chipBackgroundColor="@color/PCHome_panel"
        app:chipStrokeWidth="1dp"
        app:chipStrokeColor="@color/PCHome_border"
        android:textColor="@color/PCHome_muted" />

    <!-- Cyber keyboard overlay (hidden until toggled); sits above the bar -->
    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="84dp"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- Scrollable control bar: on narrow phones all buttons stay reachable -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_control_bar"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_disconnect"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disconnect"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:backgroundTint="@color/PCHome_danger"
                    app:strokeColor="@color/PCHome_danger" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_refresh"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/refresh"
                    android:textColor="@color/PCHome_success"
                    android:textSize="11sp"
                    app:strokeColor="@color/PCHome_success" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mode"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOĞRUDAN"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_left"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOL"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_right"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAĞ"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_esc"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESC"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ctrl"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CTRL"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_shift"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SHIFT"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_keyboard"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_rotate"
                    style="@style/Widget.PCHome.ControlButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROT"
                    android:textSize="11sp" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</FrameLayout>
