<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.PCHome.mobile.ui.ReticleView
        android:id="@+id/reticle"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.chip.Chip
        android:id="@+id/stream_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="top|start"
        android:text="@string/waiting_for_stream"
        android:checkable="false"
        android:textSize="12sp"
        app:chipBackgroundColor="@color/PCHome_panel"
        app:chipStrokeWidth="1dp"
        app:chipStrokeColor="@color/PCHome_cyan"
        android:textColor="@color/PCHome_text" />

    <com.google.android.material.chip.Chip
        android:id="@+id/info_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:layout_gravity="top|end"
        android:checkable="false"
        android:textSize="12sp"
        app:chipBackgroundColor="@color/PCHome_panel"
        app:chipStrokeWidth="1dp"
        app:chipStrokeColor="@color/PCHome_border"
        android:textColor="@color/PCHome_muted" />

    <!-- Cyber keyboard overlay (hidden until toggled) -->
    <LinearLayout
        android:id="@+id/keyboard_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="8dp"
        android:visibility="gone" />

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:fabAlignmentMode="center"
        app:fabCradleMargin="8dp"
        app:fabCradleRoundedCornerRadius="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOĞRUDAN"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_left"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOL"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_right"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAĞ"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_esc"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESC"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ctrl"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CTRL"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_keyboard"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABC"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate"
                style="@style/Widget.PCHome.ControlButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROT"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_disconnect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="@string/disconnect"
        app:backgroundTint="@color/PCHome_danger"
        app:tint="@color/white" />

</FrameLayout>
