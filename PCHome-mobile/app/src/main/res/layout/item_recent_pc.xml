<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/PCHome_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Kare kutucuk: PC'nin son görüntüsü + sil düğmesi -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/PCHome_background">

            <ImageView
                android:id="@+id/recent_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/recent_thumb_desc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recent_delete"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="@string/recent_delete_desc"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="18dp"
                app:iconTint="@color/PCHome_danger"
                app:backgroundTint="@color/black" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recent_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/PCHome_cyan"
                android:singleLine="true"
                android:ellipsize="end" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recent_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/PCHome_text"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recent_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/PCHome_cyan"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/recent_last_seen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/PCHome_muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
