<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pin_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/pin_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- ===================== El tercihi ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hand_left"
                style="@style/Widget.PCHome.Button.Key"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/hand_left"
                android:textSize="9.5sp"
                app:icon="@drawable/ic_touch"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hand_right"
                style="@style/Widget.PCHome.Button.Key"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/hand_right"
                android:textSize="9.5sp"
                app:icon="@drawable/ic_touch"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="12dp" />
        </LinearLayout>

        <!-- ===================== Başlık ===================== -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/hero_title"
            android:textAppearance="@style/TextAppearance.PCHome.Hero" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:text="@string/hero_subtitle"
            android:textAppearance="@style/TextAppearance.PCHome.Body"
            android:textColor="@color/PCHome_muted" />

        <!-- ===================== Bağlantı kartı ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/Widget.PCHome.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/connect_card_title"
                    android:textAppearance="@style/TextAppearance.PCHome.Section" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/connect_card_subtitle"
                    android:textAppearance="@style/TextAppearance.PCHome.Meta"
                    android:textColor="@color/PCHome_muted" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/server_label"
                    android:textAppearance="@style/TextAppearance.PCHome.Label" />

                <FrameLayout
                    android:id="@+id/server_layout"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <AutoCompleteTextView
                        android:id="@+id/server"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center_vertical"
                        android:hint="@string/signal_url_hint"
                        android:imeOptions="actionNext"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:textColor="@color/PCHome_text"
                        android:textColorHint="@color/PCHome_dim"
                        android:textSize="17sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pc_id_hint"
                            android:textAppearance="@style/TextAppearance.PCHome.Label" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.PCHome.Input"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="6dp"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/pc_id_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center_vertical"
                                android:imeOptions="actionNext"
                                android:inputType="number"
                                android:maxLength="7"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:textColor="@color/PCHome_text"
                                android:textColorHint="@color/PCHome_dim"
                                android:textSize="18.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/password_hint"
                            android:textAppearance="@style/TextAppearance.PCHome.Label" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.PCHome.Input"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="6dp"
                            app:endIconMode="password_toggle"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/password_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center_vertical"
                                android:imeOptions="actionDone"
                                android:inputType="numberPassword"
                                android:digits="0123456789"
                                android:maxLength="6"
                                android:paddingStart="12dp"
                                android:paddingEnd="8dp"
                                android:textColor="@color/PCHome_text"
                                android:textColorHint="@color/PCHome_dim"
                                android:textSize="18sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/remember_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:checked="true"
                    android:fontFamily="@font/inter_regular"
                    android:text="@string/remember_password"
                    android:textColor="@color/PCHome_muted"
                    android:textSize="13sp"
                    app:thumbTint="@color/switch_thumb_remember"
                    app:trackTint="@color/switch_track_remember" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_button"
                    style="@style/Widget.PCHome.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/connect"
                    app:icon="@drawable/ic_arrow_forward" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== Son bağlantılar ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/recent_title"
                android:textAppearance="@style/TextAppearance.PCHome.Section" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_hint"
                android:textAppearance="@style/TextAppearance.PCHome.Meta"
                android:textColor="@color/PCHome_dim" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/recent_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_recent_empty"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="26dp"
            android:text="@string/recent_empty"
            android:textAppearance="@style/TextAppearance.PCHome.Body"
            android:textColor="@color/PCHome_dim" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recent_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:scrollbars="none" />

        <!-- ===================== Güncelleme ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/update_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/Widget.PCHome.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_icon_button">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_update"
                        app:tint="@color/PCHome_cyan" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_section_title"
                        android:textColor="@color/PCHome_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/update_state_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.PCHome.Meta"
                        android:textColor="@color/PCHome_dim" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/update_open_button"
                    style="@style/Widget.PCHome.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/update_open" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/version_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PCHome.Meta"
            android:textColor="@color/PCHome_dim" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
