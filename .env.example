# PChome personal connection settings (this file is committed as a TEMPLATE).
# Copy it to ".env" and fill in your own address; .env is gitignored so each
# person keeps their own signal server URL out of the repository.
#
# Desktop daemon reads this file from the directory you launch it in.
# Format notes:
#   - ws://  = plain websocket (local signal server)
#   - wss:// = TLS websocket (Railway / Render / any cloud deploy)
PCHOME_SIGNAL_URL=wss://your-service.onrender.com
