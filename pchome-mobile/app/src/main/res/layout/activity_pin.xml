<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/pchome_background">

    <TextView
        android:id="@+id/server_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIGNAL SERVER"
        android:textColor="@color/pchome_text_primary"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/server"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ws://host:8080/ws"
        android:text="ws://localhost:8080/ws"
        android:textColor="@color/pchome_cyan"
        android:inputType="textUri"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/pin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PIN"
        android:textColor="@color/pchome_text_primary"
        android:textSize="14sp"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/pin_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="------"
        android:textColor="@color/pchome_cyan"
        android:textSize="64sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:inputType="number"
        android:maxLength="6"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Idle"
        android:textColor="@color/pchome_text_primary"
        android:textSize="18sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/connect_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect"
        android:textSize="16sp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        style="@style/PChomeButton" />

</LinearLayout>
